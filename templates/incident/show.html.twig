{# ============================================================================
   ONE CASE FILE — the whole record on one page.

   TWO CONTRACTS THE DESIGN INSISTS ON, and both are structural here:

   1. THE JOURNEY, NOT A DROPDOWN. A status is never a select box. The journey
      card shows where the incident is, what it passed and when, and what
      reaches each place still ahead; only the LEGAL transitions are offered,
      on the current place's row.

   2. GATED PANELS. A step owns a panel, and the panel DOES NOT EXIST until the
      step is reached. Not rendered-and-disabled — absent. There is no empty
      "resolution" form on a freshly reported incident inviting somebody to fill
      it in early, and `rail.hasReached()` is the whole of the mechanism.

   The money card and the word's own questions are the third contract: a category
   that carries no money has NO money card, and the questions a roadkill asks are
   the questions of ITS blocks, which are not a depredation's.
   ========================================================================== #}
{% extends '@UhifadhiIncident/base.html.twig' %}
{% import '@UhifadhiIncident/dashboard/_ui.html.twig' as ui %}
{% import '@UhifadhiStorage/upload/_tile.html.twig' as evidence %}

{% block title %}{{ incident.reference }} — {{ incident.headline }}{% endblock %}

{% block incident_trail_tail %} <a href="{{ path('incident_dashboard', {uuid: area.uuid}) }}">incidents</a> / {{ incident.reference|lower }}{% endblock %}

{% block shell_page_title %}{{ incident.reference }} — {{ incident.title }}{% endblock %}

{% block shell_page_subtitle %}{% set money = incident.money %}{{ incident.kind.label }} · {{ incident.subcategory.label }} · <b>{{ incident.status.label }}</b>
    · {{ incident.zoneLabel }} · filed <time datetime="{{ incident.reportedAt|date('c') }}" data-localtime-format="daystamp">{{ incident.reportedAt|date('D j M H:i')|lower }}</time>{% if incident.events|first and incident.events|first.actorName %} by {{ incident.events|first.actorName }}{% endif %}
    {#- THE SUBLINE OBEYS THE SAME TWO DOORS THE CARDS DO. A figure withheld
        below and printed here would be withheld nowhere: how much was assessed,
        and how many people are named on the record, are the sensitive facts
        themselves and not a summary of them. #}
    {%- if money and money.isAssessed and door('case-money.read', area) %} · {{ incident.money.currency }} {{ money.payable|number_format(0, '.', ',') }} {{ money.direction.assessedWord }}, {{ money.settled|number_format(0, '.', ',') }} {{ money.direction.settledWord }}{% endif %}
    {%- if door('case-files.read', area) %} · {{ incident.evidence|length }} pieces of evidence · {{ incident.parties|length }} parties{% endif %}.{% endblock %}

{% block shell_page_actions %}
    {{ parent() }}
    {# A SUPER ADMIN DELETES (ruled 28 Sep, #48): its own page, counted and typed. #}
    {% if may_delete() %}<a class="tgl w-act" href="{{ path('incident_delete', {uuid: area.uuid, reference: incident.reference}) }}">{{ ux_icon('shell:trash-2') }} Delete</a>{% endif %}
{% endblock %}

{% block incident_page %}
    {% set money = incident.money %}
    {# THE WAY BACK, on the shell's own pill — the settled cross-module idiom for
       coming off a record to the list it was opened from: at the top of the page
       body, never a page action and never a .tgl. The class is the shell's, so
       this module's sheet ships no rule for it. #}
    <a class="backbtn" href="{{ path('incident_dashboard', {uuid: area.uuid}) }}">{{ ux_icon('shell:chevron-left') }} All incidents</a>

    {# THE IDENTITY BAND — the record's own facts on the shared .factband every
       entity-detail screen wears, below the head (the settled page-chrome theme:
       the meta moved out of a sidebar card onto the band the area overview, a
       patrol and an observation all use). A segment with no data is OMITTED,
       never rendered empty. #}
    <div class="factband">
        <span class="f"><span class="k">Id</span><span class="v">{{ incident.reference }}</span></span>
        <span class="f"><span class="k">Category</span><span class="v">{{ incident.kind.label }}<em>{{ incident.subcategory.label }}</em></span></span>
        <span class="f"><span class="k">Status</span><span class="v">{{ incident.status.label }}</span></span>
        <span class="f"><span class="k">Severity</span><span class="v">{{ incident.severity.label }}</span></span>
        {# A POINT FILED OUTSIDE THE AREA'S BOUNDARY says so beside the place, here
           and on the Where card: judged once, at filing. #}
        <span class="f"><span class="k">Zone</span><span class="v">{{ incident.zoneLabel }}{% if incident.outsideArea %}<em>filed outside {{ area.name }}</em>{% endif %}</span></span>
        {% if incident.occurredAt %}<span class="f"><span class="k">Occurred</span><span class="v"><time datetime="{{ incident.occurredAt|date('c') }}" data-localtime-format="day">{{ incident.occurredAt|date('D j M')|lower }}</time><em><time datetime="{{ incident.occurredAt|date('c') }}" data-localtime-format="clock">{{ incident.occurredAt|date('H:i') }}</time></em></span></span>{% endif %}
        <span class="f"><span class="k">Filed</span><span class="v"><time datetime="{{ incident.reportedAt|date('c') }}" data-localtime-format="day">{{ incident.reportedAt|date('D j M')|lower }}</time><em><time datetime="{{ incident.reportedAt|date('c') }}" data-localtime-format="clock">{{ incident.reportedAt|date('H:i') }}</time></em></span></span>
        <span class="f"><span class="k">Verified in</span><span class="v">{% if incident.hoursToVerify is null %}—{% else %}{{ incident.hoursToVerify }} h{% endif %}<em>term {{ incident.subcategory.termLabel }}</em></span></span>
        {% if incident.assignedTo %}<span class="f"><span class="k">Responder</span><span class="v">{{ incident.assignedTo.firstName|slice(0, 1) }}. {{ incident.assignedTo.lastName }}</span></span>{% endif %}
        <span class="f"><span class="k">Source</span><span class="v">{{ incident.source.label }}<em>{{ incident.source.badge }}</em></span></span>
    </div>

    <div class="i-headchips">
        <span class="i-path">{{ ui.cat(incident.kind) }}<span class="sep">›</span><span class="i-sub">{{ incident.subcategory.label }}</span></span>
        {{ ui.status(incident.status) }}
        {{ ui.severity(incident.severity) }}
        {{ ui.zone(incident) }}
    </div>

    {# THE JOURNEY: the five places as a rail in one card. A reached place is a
       record of when and by whom, never a control; a place ahead states what
       reaches it; only the legal moves are offered, on the current place's row,
       the primary one last. "Closed" is the clock's, so it never has a button.
       → the moves come from IncidentTransitionService::available();
         POST /areas/{uuid}/modules/incidents/{reference}/transition/{name} #}
    {% set canManage = door('incidents.manage', area) %}
    <div class="c">
        <span class="tab">The journey<span class="src">· step {{ incident.status.step }} of {{ rail.steps|length }} · {{ incident.status.label }}</span></span>
        <div class="i-jr" role="list" aria-label="Where this incident stands">
            {% for step in rail.steps %}
                {% set place = step.place %}
                {% set state = step.state == 'todo' ? 'ahead' : step.state %}
                {% set reaching = place.value == 'reported' ? incident.events|first : incident.events|filter(e => e.toStatus is same as(place))|last %}
                {% set reachedBy = reaching ? reaching.actorName : null %}
                <div class="i-jr-s {{ state }}" role="listitem"{% if state == 'now' %} aria-current="step"{% endif %}>
                    <i class="i-jr-dot"></i>
                    <div class="i-jr-t">
                        <span class="i-jr-n">{{ place.label|capitalize }}</span>
                        <span class="i-jr-m">
                            {%- if state != 'ahead' and step.at %}{% if state == 'now' %}since {% endif %}<time datetime="{{ step.at|date('c') }}" data-localtime-format="daystamp">{{ step.at|date('D j M H:i')|lower }}</time>{% if reachedBy %} · {{ reachedBy }}{% endif %}
                            {%- elseif place.value == 'verified' %}when somebody competent has looked at it
                            {%- elseif place.value == 'in_progress' %}when the response starts
                            {%- elseif place.value == 'resolved' and money and money.direction.value == 'compensation' %}when the claimant is paid, or the money is waived
                            {%- elseif place.value == 'resolved' and money %}when the fine is collected, or the money is waived
                            {%- elseif place.value == 'resolved' %}when the work is done
                            {%- elseif place.value == 'closed' and rail.closesAt %}by itself on <time datetime="{{ rail.closesAt|date('c') }}" data-localtime-format="day">{{ rail.closesAt|date('j M Y') }}</time>, {{ constant('Uhifadhi\\Incident\\Workflow\\IncidentWorkflow::CLOSE_AFTER_DAYS') }} days after resolved
                            {%- elseif place.value == 'closed' %}by itself, {{ constant('Uhifadhi\\Incident\\Workflow\\IncidentWorkflow::CLOSE_AFTER_DAYS') }} days after resolved
                            {%- endif -%}
                        </span>
                    </div>
                    {% if state == 'now' and canManage and rail.available is not empty %}
                        <div class="i-jr-acts">
                            {% for transition in rail.available|reverse %}
                                <form method="post" class="i-transform" action="{{ path('incident_transition', {uuid: area.uuid, reference: incident.reference, transition: transition.value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                                    <button type="submit" class="{{ loop.last ? 'cta' : 'tgl' }}">{{ transition.label }}{{ loop.last ? ' →' }}</button>
                                </form>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    {% set seesCaseFile = door('case-files.read', area) %}
    {% set seesMoney = door('case-money.read', area) %}
    {% set canRecordMoney = seesMoney and door('case-money.manage', area) and incident.subcategory.carriesMoney
        and incident.status.hasReached(incident.subcategory.moneyDirection.recordableFrom) %}
    {% set visibleEvents = incident.events|filter(e => (e.kind.value != 'money' or seesMoney) and (e.kind.value != 'evidence' or seesCaseFile)) %}
    {% set showsMoney = seesMoney and (money or incident.claimedAtFiling is not null) %}
    {% set reachedSteps = rail.steps|filter(s => s.state != 'todo' and s.place.value != 'closed') %}
    {# THE INDEX, one row per card, over one column of full-width cards: the
       record, then under a head the steps reached so far and the category's
       fields. A card the viewer may not see has no row either. #}
    {% set rows = [{id: 'where', label: 'Where'}] %}
    {% if seesCaseFile %}{% set rows = rows|merge([{id: 'narrative', label: 'Narrative'}]) %}{% endif %}
    {% set rows = rows|merge([{id: 'timeline', label: 'Timeline', count: visibleEvents|length}]) %}
    {% if seesCaseFile %}{% set rows = rows|merge([{id: 'evidence', label: 'Evidence', count: incident.evidence|length}]) %}{% endif %}
    {% if showsMoney %}{% set rows = rows|merge([{id: 'money', label: 'Money'}]) %}{% endif %}
    {% if seesCaseFile %}{% set rows = rows|merge([{id: 'parties', label: 'Involved parties', count: incident.partiesOnRecord|length}]) %}{% endif %}
    {% set rows = rows|merge([{id: 'provenance', label: 'Provenance & links', count: 1 + incident.links|length}]) %}
    {% for step in reachedSteps %}{% set rows = rows|merge([{id: 'step-' ~ step.place.value, label: step.place.label|capitalize}]) %}{% endfor %}
    {% set rows = rows|merge([{id: 'category', label: 'Category fields'}]) %}
    {% embed '@Shell/_onpage.html.twig' with {label: 'On this page', rows: rows} %}
        {% import '@UhifadhiIncident/dashboard/_ui.html.twig' as ui %}
        {% import '@UhifadhiStorage/upload/_tile.html.twig' as evidence %}
        {% block shell_onpage_main %}
            <div id="where" class="c plate-fill">
                <span class="tab">Where<span class="src">· {{ incident.zoneLabel }}{% if incident.outsideArea %} · filed outside {{ area.name }}{% endif %}</span></span>
                {# The SAME plate the dashboard maps draw, stating this incident's
                   own category alone: one mark, one meaning, wherever it is drawn.
                   The legend floats over the imagery, so the card has no region
                   under it to leave empty. #}
                {{ render_map(map, {'role': 'img', 'aria-label': 'Where this incident was filed'}) }}
            </div>

            {% if seesCaseFile %}
            <div id="narrative" class="c">
                <span class="tab">Narrative<span class="src">· as taken · verbatim</span></span>
                {% if incident.narrative %}
                    <div class="i-quote">“{{ incident.narrative }}”</div>
                {% else %}
                    <div class="use">Nothing was taken down in the reporter's own words.</div>
                {% endif %}
                {% if incident.assessment %}
                    <div class="i-assessment">{{ incident.assessment }}</div>
                {% endif %}
                <div class="use">The report as it was given, kept apart from the officer's assessment. Two voices, two fields —
                    one of them is evidence and the other is judgement.</div>
            </div>
            {% endif %}

            <div id="timeline" class="c">
                <span class="tab">Timeline<span class="src">· {{ visibleEvents|length }} events · append-only</span></span>
                {# THE TIMELINE OBEYS THE TWO DOORS TOO. A money event says what
                   was claimed and what was paid, and an evidence event names a
                   file that was attached — the same facts the cards above are
                   withheld for. A trail that repeated them would make the
                   withholding cosmetic. #}
                <div class="i-tl">
                    {% for event in visibleEvents %}
                        <div class="i-tl-item {{ event.kind.cssClass }}">
                            <span class="i-tl-t"><time datetime="{{ event.occurredAt|date('c') }}" data-localtime-format="stamp">{{ event.occurredAt|date('D j M · H:i')|lower }}</time> · {{ event.toStatus ? event.toStatus.label : event.kind.value }}</span>
                            <span class="i-tl-b">{% if event.actorName %}<span class="who">{{ event.actorName }}</span> {% endif %}{{ event.body }}{% if event.detail %}<em>{{ event.detail }}</em>{% endif %}</span>
                        </div>
                    {% endfor %}
                </div>
                <div class="use">Nothing on this timeline is ever edited or removed. A correction is a new event that says what
                    was corrected — which is what makes the record worth anything in a hearing.</div>
            </div>

            {% if seesCaseFile %}
            <div id="evidence" class="c">
                <span class="tab">Evidence<span class="src">· {{ incident.evidence|length }} attached</span></span>
                {# ONE GRID, ONE TILE. A file already attached and a file that arrived
                   a second ago must be the same box, or the card shows two kinds of
                   tile for the same thing — which is exactly the drift the one
                   upload component exists to end. So a kept tile is the STORAGE's
                   own finished state, drawn from the macro the component draws it
                   with: a photograph shows the one small picture that was made for
                   it and opens the file, and one without says which reason applies,
                   in the storage's word. Nothing here defines a class or a state.

                   THE ADD TILE IS ONE TWIG LINE and is not drawn for somebody who
                   may not use it — storage asks the target's mayUpload() at render
                   time, so this template carries no permission check of its own. #}
                <div class="i-evgrid">
                    {% for file in evidenceFiles %}
                        {{ evidence.entry(file, filePages ? path('storage_files_show', {key: file.key}) : '') }}
                    {% endfor %}
                    {{ render_upload('incident:' ~ incident.uuid, 'tile', {label: 'Add evidence'}) }}
                </div>
                <div class="use">Each photograph keeps the position and the time the handset recorded, not the time it was
                    uploaded — so the map above places them where they were taken.</div>
            </div>
            {% endif %}

            {# THE MONEY CARD EXISTS ONLY WHERE THE CATEGORY CARRIES MONEY. On a
               natural mortality there is no card at all — absent, not empty. #}
            {% set direction = money ? money.direction : incident.subcategory.moneyDirection %}
            {% if seesMoney and (money or incident.claimedAtFiling is not null) %}
                <div id="money" class="c">
                    <span class="tab">Money<span class="src">· this category carries {{ direction.value }}</span></span>
                    <div class="i-moneyblock">
                        <div class="hd">{{ ux_icon('incident:circle-dollar-sign') }}<b>{{ direction.heading }}</b></div>
                        {# THE FIGURE THE MONEY BLOCK ASKED AT FILING — the claimant's
                           own, or the officer's at the roadside, before anybody had
                           judged it. It is NOT an assessment and it is not the money
                           record: the four amounts below are written by whoever
                           judges and pays, in the states the money flow names. #}
                        {% if incident.claimedAtFiling is not null %}<div class="i-mrow"><span>claimed at filing</span>{{ ui.amount(money ? money.currency : 'TZS', incident.claimedAtFiling) }}</div>{% endif %}
                        {% if money and money.claimed is not null %}<div class="i-mrow"><span>claimed</span>{{ ui.amount(money.currency, money.claimed) }}</div>{% endif %}
                        {% if money %}
                        {% if money.assessed is not null %}<div class="i-mrow"><span>assessed</span>{{ ui.amount(money.currency, money.assessed) }}</div>{% endif %}
                        {% if money.approved is not null %}<div class="i-mrow"><span>approved</span>{{ ui.amount(money.currency, money.approved) }}</div>{% endif %}
                        <div class="i-mrow"><span>{{ money.direction.settledWord }}</span>{{ ui.amount(money.currency, money.settled, money.settled > 0 ? 'paid' : 'nil') }}</div>
                        <div class="i-mrow"><span>outstanding</span>{{ ui.amount(money.currency, money.outstanding, 'due') }}</div>
                        <div class="i-moneybar"><i style="width:{{ money.settledPercent }}%"></i></div>
                        <div class="i-kpi-note i-moneypct">{{ money.settledPercent }}% {{ money.direction.settledWord }}{% if money.isWaived %} · waived: {{ money.waivedReason }}{% endif %}</div>
                        {% else %}
                        <div class="i-kpi-note i-moneypct">nothing judged yet — a {{ direction.value }} record is opened
                            in the state the money flow names, never at filing</div>
                        {% endif %}
                        <div class="use i-moneywhy">Four amounts, not one, because they are four different facts — what was asked,
                            what was judged, what was signed off and what actually moved. A single “amount” field would lose the
                            argument this incident is about.</div>
                    </div>
                </div>
            {% endif %}

            {# THE MONEY WRITE SURFACE — a GATED PANEL, and the gate is the
               DIRECTION's. A compensation claim is taken from `verified`, a fine
               only from `in progress`; the service refuses the same two places, so
               the panel is never drawn on a POST that would be refused. Only where
               the sub-category carries money, and the direction is FIXED (inherited
               from the category), never a choice made here. The row is born on the
               first amount, which is when the read-only card above appears. → POST
               incident_money / incident_money/waive, guarded by `case-money.manage`. #}
            {% if canRecordMoney %}
                {% set dir = incident.subcategory.moneyDirection %}
                <div class="c i-moneyedit">
                    <span class="tab">Record money<span class="src">· {{ dir.value }} · direction is fixed</span></span>
                    <div class="i-moneyedit-dir">{{ ux_icon('incident:circle-dollar-sign') }}<b>{{ dir.heading }}</b></div>
                    <form method="post" class="i-moneyform" action="{{ path('incident_money', {uuid: area.uuid, reference: incident.reference}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <div class="i-fieldset">
                            <div class="i-fld"><label for="money-claimed">Claimed</label><span><input type="number" min="0" step="1" inputmode="numeric" id="money-claimed" name="claimed" value="{{ money and money.claimed is not null ? money.claimed }}"></span></div>
                            <div class="i-fld"><label for="money-assessed">Assessed</label><span><input type="number" min="0" step="1" inputmode="numeric" id="money-assessed" name="assessed" value="{{ money and money.assessed is not null ? money.assessed }}"></span></div>
                            <div class="i-fld"><label for="money-approved">Approved</label><span><input type="number" min="0" step="1" inputmode="numeric" id="money-approved" name="approved" value="{{ money and money.approved is not null ? money.approved }}"></span></div>
                            <div class="i-fld"><label for="money-settled">{{ dir.settledWord|capitalize }}</label><span><input type="number" min="0" step="1" inputmode="numeric" id="money-settled" name="settled" value="{{ money ? money.settled : '' }}"></span></div>
                        </div>
                        <div class="i-moneyact">
                            <button type="submit" class="cta">Record →</button>
                            <span class="i-moneyhint">Whole units, one save at a time. The incident cannot be marked resolved until the money is settled or waived.</span>
                        </div>
                    </form>
                    {% if not (money and money.isWaived) %}
                        <form method="post" class="i-moneyform i-waiveform" action="{{ path('incident_money_waive', {uuid: area.uuid, reference: incident.reference}) }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <div class="i-fld"><label for="money-waive">Waive · reason</label><span><textarea id="money-waive" name="reason" rows="2" placeholder="Why the money is being given up on — a waiver without a reason is a deletion"></textarea></span></div>
                            <div class="i-moneyact"><button type="submit" class="tgl">Waive with reason</button></div>
                        </form>
                    {% endif %}
                </div>
            {% endif %}

            {% if seesCaseFile %}
            <div id="parties" class="c">
                {# THE RECORDS AND THE REPORT FORM'S PARTIES, once each. #}
                {% set parties = incident.partiesOnRecord %}
                <span class="tab">Involved parties<span class="src">· {{ parties|length }}</span></span>
                {% for party in parties %}
                    <div class="i-party">
                        <span class="av">{{ party.initials }}</span>
                        <span class="nm">{{ party.name }}{% if party.describedAs %}<em>{{ party.describedAs }}</em>{% endif %}</span>
                        <span class="i-role {{ party.role.cssClass }}">{{ party.role.label }}</span>
                    </div>
                {% else %}
                    <div class="use">Nobody has been named on this record yet.</div>
                {% endfor %}
                <div class="use i-partynote">A suspect, a claimant, a witness and the ranger who filed it are all parties, each with a role. The animal is a party too, so a repeat offender can be recognised across incidents.</div>
            </div>
            {% endif %}

            <div id="provenance" class="c">
                <span class="tab">Provenance &amp; links</span>
                {% if incident.hasProvenance and incident.sourceRecordDeletedAt %}
                    {# THE RECORD IT CAME FROM WAS DELETED (ruled 28 Sep, #48): it stays, without its link. #}
                    <span class="i-prov">{{ ux_icon('incident:git-branch') }}
                        <span class="bd"><b>{{ incident.sourceRecordLabel }}</b> — this incident was filed from that record, which has since been deleted.<em>source: {{ incident.source.badge }}</em></span></span>
                {% elseif incident.hasProvenance %}
                    <a class="i-prov" href="{{ incident.sourceRecordUrl ?? '#' }}">{{ ux_icon('incident:git-branch') }}
                        <span class="bd"><b>{{ incident.sourceRecordLabel }}</b> — this incident was filed from that record and stays
                            linked to it.<em>source: {{ incident.source.badge }}</em></span>
                        <span class="go">{{ incident.sourceRecordUrl ? 'Open →' : ' ' }}</span></a>
                {% else %}
                    <span class="i-prov">{{ ux_icon('incident:file-pen') }}
                        <span class="bd"><b>{{ incident.source.label|capitalize }}</b> — entered directly, with no earlier record
                            behind it.<em>source: {{ incident.source.badge }}</em></span><span class="go"> </span></span>
                {% endif %}
                {% for link in incident.links %}
                    <a class="i-prov" href="{{ path('incident_show', {uuid: area.uuid, reference: link.related.reference}) }}">{{ ux_icon('incident:link') }}
                        <span class="bd"><b>Related — {{ link.related.reference }}</b>{% if link.note %} {{ link.note }}{% endif %}
                            <em>{% if link.linkedByName %}linked by {{ link.linkedByName }} · {% endif %}a link is a claim, and it carries who made it</em></span>
                        <span class="go">Open →</span></a>
                {% endfor %}
                <div class="use i-partynote">Provenance is never overwritten. An incident filed from a patrol observation keeps
                    that parentage forever — that is the hand-off the patrols module's <b>File as incident</b> button writes.</div>
            </div>

            <h2 class="zone">The steps</h2>
            <p class="pgsub">One panel per step reached so far.{% if incident.subcategory.carriesMoney %} Resolution opens once the money on this incident is settled or waived with a reason; the{% else %} The{% endif %} case closes by itself {{ constant('Uhifadhi\\Incident\\Workflow\\IncidentWorkflow::CLOSE_AFTER_DAYS') }} days after resolution.</p>

            {# GATED PANELS. A panel for an unreached place is NOT RENDERED, ever. #}
                {# A panel for an unreached step is not rendered at all; "closed" is
                   never a person's panel, because the clock reaches it. #}
                {% for step in reachedSteps %}
                    <div id="step-{{ step.place.value }}" class="c{{ step.state == 'now' ? ' i-step-now' }}">
                        <span class="tab">Step {{ step.place.step }} — {{ step.place.label }}<span class="src">· {{ step.state == 'now' ? 'current step' : 'done' }}</span></span>
                        {# The event that PUT it in this place — the filing itself for
                           step one, and the transition for every step after. #}
                        {% set stepEvents = step.place.value == 'reported'
                            ? incident.events|slice(0, 1)
                            : incident.events|filter(e => e.toStatus and e.toStatus.value == step.place.value) %}
                        {% for event in stepEvents %}
                            <div class="rln"><span>{{ event.actorName ? 'By' : 'Recorded' }}</span><span>{{ event.actorName ?? 'the clock' }}</span></div>
                            <div class="rln"><span>When</span><span><time datetime="{{ event.occurredAt|date('c') }}" data-localtime-format="daystamp">{{ event.occurredAt|date('D j M · H:i')|lower }}</time></span></div>
                            {% if event.detail %}<div class="rln"><span>How</span><span>{{ event.detail }}</span></div>{% endif %}
                        {% endfor %}
                        {% if step.state == 'now' %}
                            {% for reason in rail.blocked %}<div class="rln"><span>Blocking</span><span class="w">{{ reason }}</span></div>{% endfor %}
                            <div class="rln"><span>Elapsed</span><span>{{ incident.ageInHours(now) }} h of a {{ incident.subcategory.termLabel }} term</span></div>
                        {% endif %}
                    </div>
                {% endfor %}

            {# WHAT THIS WORD ASKED, AND WHAT WAS ANSWERED — one set per behaviour block
               the sub-category switched on, in the order the kinds editor holds them and
               in the order the block puts its questions. A block with no answers still
               prints, with a dash under each question, because "nobody answered this" is
               a fact about the record and an absent panel would hide it.

               A REPEATING BLOCK PRINTS ITS ROWS AS ROWS. Twelve snares and two carcasses
               were two answers when they were given and they stay two answers here. #}
            <h2 class="zone">What this category asks for</h2>
            <p class="pgsub">The fields this category records.{% if incident.subcategory.carriesMoney %} It carries {{ incident.subcategory.moneyDirection.value }}, so the amount claimed at filing is recorded here too.{% endif %}</p>

            {# THE PARTIES BLOCK IS THE CASE FILE, wherever it is drawn. The block a
               word switched on asks for a suspect's name and a claimant's household,
               and printing those answers here would hand back exactly what the
               Involved parties card is withheld for. #}
            <div id="category">
            {% for set in blockSets|filter(s => s.block.value != 'parties' or seesCaseFile) %}
                {% set answers = incident.blockAnswers[set.block.value]|default({}) %}
                <div class="i-fieldset">
                    <div class="hd">{{ set.title }}<span class="src">· {{ set.caption }}</span></div>
                    {% if set.repeats %}
                        {% for row in answers.rows|default([]) %}
                            {% set cells = [] %}
                            {% for question in set.rowQuestions %}
                                {% if row[question.key] is defined %}
                                    {% set cells = cells|merge([question.label|lower ~ ' ' ~ row[question.key]]) %}
                                {% endif %}
                            {% endfor %}
                            <div class="i-fld"><label>{{ loop.index }}</label><span>{{ cells|join(' · ') }}</span></div>
                        {% else %}
                            <div class="i-fld"><label>1</label><span>—</span></div>
                        {% endfor %}
                    {% endif %}
                    {% for question in set.questions %}
                        <div class="i-fld"><label>{{ question.label }}</label>
                            {# AN ANSWER FROM ONE OF THE AREA'S LISTS IS PRINTED AS THE WORD,
                               not as the stable key the record keeps — and a retired word still
                               resolves, because that is what retiring promises. #}
                            <span>{% if set.block.isMoney %}{{ not seesMoney ? 'withheld' : (incident.claimedAtFiling is null ? '—' : ui.amount(money ? money.currency : 'TZS', incident.claimedAtFiling, 'claimed at filing')) }}{% elseif question.areaList and answers[question.key] is defined %}{{ areaWords.label(question.areaList, answers[question.key]) }}{% else %}{{ answers[question.key]|default('—') }}{% endif %}</span></div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="i-fieldset">
                    <div class="hd">{{ incident.subcategory.path }}</div>
                    <div class="i-fld"><label>Fields</label><span>this category records nothing beyond what every incident answers</span></div>
                </div>
            {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
